@dataclass(frozen=True)
class Token:
    tipo: TokenType
    lexema: str
    linea: int
    columna: int


@dataclass(frozen=True)
class DiagnosticoError:
    tipo: str
    linea: int
    columna: int
    detalle: str

    @property
    def mensaje(self) -> str:
        return (
            f"Error {self.tipo} en linea {self.linea}, columna {self.columna}: "
            f"{self.detalle}"
        )


@dataclass
class ResultadoAnalisis:
    path: Path
    source: str
    ok: bool
    mensaje: str
    diagnostics: list[DiagnosticoError]


class SyntaxErrorParser(Exception):
    def __init__(self, linea: int, columna: int, detalle: str):
        self.linea = linea
        self.columna = columna
        self.detalle = detalle
        super().__init__(
            f"Error sintactico en linea {linea}, columna {columna}: {detalle}"
        )


