    "PROGRAM": TokenType.PROGRAM,
    "VAR": TokenType.VAR,
    "INTEGER": TokenType.INTEGER,
    "BOOLEAN": TokenType.BOOLEAN,
    "TRUE": TokenType.TRUE,
    "FALSE": TokenType.FALSE,
    "PROCEDURE": TokenType.PROCEDURE,
    "FUNCTION": TokenType.FUNCTION,
    "BEGIN": TokenType.BEGIN,
    "END": TokenType.END,
    "IF": TokenType.IF,
    "THEN": TokenType.THEN,
    "ELSE": TokenType.ELSE,
    "WHILE": TokenType.WHILE,
    "DO": TokenType.DO,
    "READ": TokenType.READ,
