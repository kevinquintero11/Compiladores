}


OPERADORES_MATEMATICOS_LEXICOS = {
    "SUMA": TokenType.MAS,
    "RESTA": TokenType.MENOS,
    "MULTIPLICACION": TokenType.POR,
}


OPERADORES_RELACIONALES_LEXICOS = {
    "IGUAL": TokenType.IGUAL,
    "DISTINTO": TokenType.DISTINTO,
    "MENOR": TokenType.MENOR,
    "MENOR_IGUAL": TokenType.MENOR_IGUAL,
    "MAYOR": TokenType.MAYOR,
    "MAYOR_IGUAL": TokenType.MAYOR_IGUAL,
}


RUTA_ANALIZADOR_LEXICO = Path(__file__).resolve().with_name("analizadorLexico")


class EntradaNoValidaParaSintactico(Exception):
    pass


@lru_cache(maxsize=1)
def obtener_funcion_analizador_lexico():
    if not RUTA_ANALIZADOR_LEXICO.exists():
        raise FileNotFoundError(
            f"No existe el archivo del analizador lexico: {RUTA_ANALIZADOR_LEXICO}"
        )

    namespace = runpy.run_path(str(RUTA_ANALIZADOR_LEXICO))
    analizar = namespace.get("analizar")

    if analizar is None:
        raise RuntimeError(
            "No se pudo cargar la funcion 'analizar' desde analizadorLexico"
        )

    return analizar


def convertir_token_lexico(token_lexico: tuple) -> Token:
    tipo_lexico, lexema, linea, columna, *resto = token_lexico
    atributo = resto[0] if resto else None

    if tipo_lexico == "OPERADOR_MATEMATICO":
        tipo = OPERADORES_MATEMATICOS_LEXICOS.get(atributo)
        if tipo is None:
            raise SyntaxErrorParser(
                linea,
                columna,
                f"se encontro {lexema!r}, simbolo no soportado por la gramatica",
            )
        return Token(tipo, lexema, linea, columna)

    if tipo_lexico == "OPER_RELACIONAL":
        tipo = OPERADORES_RELACIONALES_LEXICOS.get(atributo)
        if tipo is None:
            raise SyntaxErrorParser(
                linea,
                columna,
                f"se encontro {lexema!r}, simbolo no soportado por la gramatica",
            )
        return Token(tipo, lexema, linea, columna)

    tipo = LEXICO_A_SINTACTICO.get(tipo_lexico)
    if tipo is None:
        raise SyntaxErrorParser(
            linea,
            columna,
            f"se encontro {lexema!r}, simbolo no soportado por la gramatica",
        )

    return Token(tipo, lexema, linea, columna)


def calcular_posicion_eof(source: str) -> tuple[int, int]:
    linea = 1
    columna = 1

    for caracter in source:
        if caracter == "\n":
            linea += 1
            columna = 1
        else:
            columna += 1

    return linea, columna


def obtener_tokens_desde_analizador_lexico(source: str) -> list[Token]:
    analizar_lexico = obtener_funcion_analizador_lexico()
    _, tokens_lexicos, errores = analizar_lexico(source)

    if errores:
        raise EntradaNoValidaParaSintactico(
            "El archivo debe pasar satisfactoriamente por analizadorLexico antes del analisis sintactico"
        )

    tokens = [convertir_token_lexico(token_lexico) for token_lexico in tokens_lexicos]
    linea_eof, columna_eof = calcular_posicion_eof(source)
    tokens.append(Token(TokenType.EOF, "", linea_eof, columna_eof))
    return tokens


class Parser:
    """Analizador sintáctico descendente recursivo predictivo."""

    RELACIONES = {
        TokenType.IGUAL,
        TokenType.DISTINTO,
        TokenType.MENOR,
        TokenType.MENOR_IGUAL,
        TokenType.MAYOR,
        TokenType.MAYOR_IGUAL,
    }

    OPERADORES_ADITIVOS = {
        TokenType.MAS,
        TokenType.MENOS,
        TokenType.OR,
    }

    OPERADORES_MULTIPLICATIVOS = {
        TokenType.POR,
        TokenType.DIV,
        TokenType.AND,
    }

    FIRST_TIPO = {
        TokenType.INTEGER,
        TokenType.BOOLEAN,
    }

    FIRST_COMANDO = {
        TokenType.IDENTIFICADOR,
        TokenType.BEGIN,
        TokenType.IF,
        TokenType.WHILE,
        TokenType.READ,
        TokenType.WRITE,
    }

    TOKENS_RECUPERACION = {
        TokenType.PUNTO_Y_COMA,
        TokenType.DOS_PUNTOS,
        TokenType.COMA,
        TokenType.PUNTO,
        TokenType.PARENTESIS_CIERRA,
        TokenType.BEGIN,
        TokenType.END,
        TokenType.THEN,
        TokenType.ELSE,
        TokenType.DO,
        TokenType.PROCEDURE,
        TokenType.FUNCTION,
        TokenType.VAR,
        TokenType.EOF,
    }

    TOKENS_FIN_EXPRESION = {
        TokenType.PUNTO_Y_COMA,
        TokenType.PARENTESIS_CIERRA,
        TokenType.COMA,
        TokenType.THEN,
        TokenType.DO,
        TokenType.END,
        TokenType.ELSE,
        TokenType.EOF,
    }

    def __init__(self, tokens: list[Token]):
        self.tokens = tokens
        self.current = 0
        self.diagnostics: list[DiagnosticoError] = []

    @property
    def preanalisis(self) -> Token:
        return self.tokens[self.current]

    def parse(self) -> list[DiagnosticoError]:
        self.programa()
        self.match(TokenType.EOF)
        return self.diagnostics

    # <programa> ::= program <identificador> ; <bloque> .
    def programa(self) -> None:
        self.match(TokenType.PROGRAM)
        self.match(TokenType.IDENTIFICADOR)
        self.match(TokenType.PUNTO_Y_COMA)
        self.bloque()
        self.match(TokenType.PUNTO)

    # <bloque> ::= <parte_declaraciones_variables>
    #              <parte_declaraciones_subrutinas>
    #              <comando_compuesto>
    def bloque(self) -> None:
        self.parte_declaraciones_variables()
        self.parte_declaraciones_subrutinas()
        self.comando_compuesto()

    # <parte_declaraciones_variables> ::= var <lista_declaraciones_variables> ; | λ
    def parte_declaraciones_variables(self) -> None:
        if self.check(TokenType.VAR):
            self.match(TokenType.VAR)
            self.lista_declaraciones_variables()
            self.match(
                TokenType.PUNTO_Y_COMA,
                {TokenType.PROCEDURE, TokenType.FUNCTION, TokenType.BEGIN, TokenType.EOF},
            )

    # <lista_declaraciones_variables> ::= <declaracion_variables>
    #                                     <lista_declaraciones_variables_aux>
    def lista_declaraciones_variables(self) -> None:
        self.declaracion_variables()
        self.lista_declaraciones_variables_aux()

    # <lista_declaraciones_variables_aux> ::= ;
    #     <declaracion_variables> <lista_declaraciones_variables_aux> | λ
    #
    # Nota de implementación:
    # En la regla original:
    #   var declaracion { ; declaracion } ;
    # el último ';' es terminador de la parte var.
    # Por eso solo consumimos ';' como separador si el token siguiente
    # inicia otra declaracion de variables.
    def lista_declaraciones_variables_aux(self) -> None:
        if self.check(TokenType.PUNTO_Y_COMA) and self.check_next(TokenType.IDENTIFICADOR):
            self.match(TokenType.PUNTO_Y_COMA)
            self.declaracion_variables()
            self.lista_declaraciones_variables_aux()
        elif self.check(TokenType.IDENTIFICADOR):
            self.registrar_error("se esperaba ;, se encontro inicio de una nueva declaracion")
            self.declaracion_variables()
            self.lista_declaraciones_variables_aux()

    # <declaracion_variables> ::= <lista_identificadores> : <tipo>
    def declaracion_variables(self) -> None:
        self.lista_identificadores()
        self.match(
            TokenType.DOS_PUNTOS,
            self.FIRST_TIPO | {TokenType.PUNTO_Y_COMA, TokenType.BEGIN, TokenType.PROCEDURE, TokenType.FUNCTION},
        )
        self.tipo()

    # <lista_identificadores> ::= identificador <lista_identificadores_aux>
    def lista_identificadores(self) -> None:
        self.match(TokenType.IDENTIFICADOR)
        self.lista_identificadores_aux()

    # <lista_identificadores_aux> ::= , identificador <lista_identificadores_aux> | λ
    def lista_identificadores_aux(self) -> None:
        if self.check(TokenType.COMA):
            self.match(TokenType.COMA)
            self.match(TokenType.IDENTIFICADOR)
            self.lista_identificadores_aux()

    # <tipo> ::= integer | boolean
    def tipo(self) -> None:
        if self.check(TokenType.INTEGER):
            self.match(TokenType.INTEGER)
        elif self.check(TokenType.BOOLEAN):
            self.match(TokenType.BOOLEAN)
        else:
            self.error(
                "tipo: integer o boolean",
                {TokenType.PUNTO_Y_COMA, TokenType.PARENTESIS_CIERRA, TokenType.BEGIN, TokenType.PROCEDURE, TokenType.FUNCTION, TokenType.EOF},
            )

    # <booleano> ::= true | false
    # Produccion incluida por equivalencia con la gramatica,
    # aunque hoy no esta conectada desde <factor>.
    def booleano(self) -> None:
        if self.check(TokenType.TRUE):
            self.match(TokenType.TRUE)
        elif self.check(TokenType.FALSE):
            self.match(TokenType.FALSE)
        else:
            self.error("booleano: true o false", self.TOKENS_FIN_EXPRESION)

    # <parte_declaraciones_subrutinas> ::= <lista_procedimientos> <lista_funciones>
    def parte_declaraciones_subrutinas(self) -> None:
        self.lista_procedimientos()
        self.lista_funciones()

    # <lista_procedimientos> ::= <declaracion_procedimiento> ; <lista_procedimientos> | λ
    def lista_procedimientos(self) -> None:
        if self.check(TokenType.PROCEDURE):
            self.declaracion_procedimiento()
            self.match(
                TokenType.PUNTO_Y_COMA,
                {TokenType.PROCEDURE, TokenType.FUNCTION, TokenType.BEGIN, TokenType.EOF},
            )
            self.lista_procedimientos()

    # <lista_funciones> ::= <declaracion_funcion> ; <lista_funciones> | λ
    def lista_funciones(self) -> None:
        if self.check(TokenType.FUNCTION):
            self.declaracion_funcion()
            self.match(
                TokenType.PUNTO_Y_COMA,
                {TokenType.FUNCTION, TokenType.BEGIN, TokenType.EOF},
            )
            self.lista_funciones()

    # <declaracion_procedimiento> ::= procedure identificador <parametros_opcionales> ; <bloque>
    def declaracion_procedimiento(self) -> None:
        self.match(TokenType.PROCEDURE)
        self.match(TokenType.IDENTIFICADOR)
        self.parametros_opcionales()
        self.match(TokenType.PUNTO_Y_COMA, {TokenType.VAR, TokenType.PROCEDURE, TokenType.FUNCTION, TokenType.BEGIN})
        self.bloque()

    # <declaracion_funcion> ::= function identificador <parametros_opcionales> : <tipo> ; <bloque>
    def declaracion_funcion(self) -> None:
        self.match(TokenType.FUNCTION)
        self.match(TokenType.IDENTIFICADOR)
        self.parametros_opcionales()
        self.match(TokenType.DOS_PUNTOS, self.FIRST_TIPO | {TokenType.PUNTO_Y_COMA})
        self.tipo()
        self.match(TokenType.PUNTO_Y_COMA, {TokenType.VAR, TokenType.PROCEDURE, TokenType.FUNCTION, TokenType.BEGIN})
        self.bloque()

    # <parametros_opcionales> ::= ( <lista_parametros> ) | λ
    def parametros_opcionales(self) -> None:
        if self.check(TokenType.PARENTESIS_ABRE):
            self.match(TokenType.PARENTESIS_ABRE)
            self.lista_parametros()
            self.match(TokenType.PARENTESIS_CIERRA, {TokenType.DOS_PUNTOS, TokenType.PUNTO_Y_COMA})

    # <lista_parametros> ::= <parametro> <lista_parametros_aux>
    def lista_parametros(self) -> None:
        self.parametro()
        self.lista_parametros_aux()

    # <lista_parametros_aux> ::= ; <parametro> <lista_parametros_aux> | λ
    def lista_parametros_aux(self) -> None:
        if self.check(TokenType.PUNTO_Y_COMA):
            self.match(TokenType.PUNTO_Y_COMA)
            self.parametro()
            self.lista_parametros_aux()
        elif self.check(TokenType.IDENTIFICADOR):
            self.registrar_error("se esperaba ;, se encontro inicio de un nuevo parametro")
            self.parametro()
            self.lista_parametros_aux()

    # <parametro> ::= <lista_identificadores> : <tipo>
    def parametro(self) -> None:
        self.lista_identificadores()
        self.match(TokenType.DOS_PUNTOS, self.FIRST_TIPO | {TokenType.PUNTO_Y_COMA, TokenType.PARENTESIS_CIERRA})
        self.tipo()

    # <comando_compuesto> ::= begin <lista_comandos> <punto_y_coma_opcional> end
    def comando_compuesto(self) -> None:
        self.match(TokenType.BEGIN, self.FIRST_COMANDO | {TokenType.END})
        self.lista_comandos()
        self.punto_y_coma_opcional()
        self.match(TokenType.END)

    # <lista_comandos> ::= <comando> <lista_comandos_aux>
    def lista_comandos(self) -> None:
        self.comando()
        self.lista_comandos_aux()

    # <lista_comandos_aux> ::= ; <comando> <lista_comandos_aux> | λ
    def lista_comandos_aux(self) -> None:
        if self.check(TokenType.PUNTO_Y_COMA):
            self.match(TokenType.PUNTO_Y_COMA)
            if self.preanalisis.tipo in self.FIRST_COMANDO:
                self.comando()
                self.lista_comandos_aux()
        elif self.preanalisis.tipo in self.FIRST_COMANDO:
            self.registrar_error("se esperaba ; entre comandos")
            self.comando()
            self.lista_comandos_aux()

    # <punto_y_coma_opcional> ::= ; | λ
    def punto_y_coma_opcional(self) -> None:
        if self.check(TokenType.PUNTO_Y_COMA):
            self.match(TokenType.PUNTO_Y_COMA)

    # <comando> ::= identificador <resto_comando_identificador>
    #             | <comando_compuesto>
    #             | <comando_condicional>
    #             | <comando_repetitivo>
    #             | <comando_entrada_salida>
    def comando(self) -> None:
        if self.check(TokenType.IDENTIFICADOR):
            self.match(TokenType.IDENTIFICADOR)
            self.resto_comando_identificador()
        elif self.check(TokenType.BEGIN):
            self.comando_compuesto()
        elif self.check(TokenType.IF):
            self.comando_condicional()
        elif self.check(TokenType.WHILE):
            self.comando_repetitivo()
        elif self.check(TokenType.READ) or self.check(TokenType.WRITE):
            self.comando_entrada_salida()
        else:
            self.error("comando", {TokenType.PUNTO_Y_COMA, TokenType.END, TokenType.ELSE, TokenType.EOF})

    # <resto_comando_identificador> ::= := <expresion> | ( <lista_expresiones> )
    def resto_comando_identificador(self) -> None:
        if self.check(TokenType.ASIGNACION):
            self.match(TokenType.ASIGNACION)
            self.expresion()
        elif self.check(TokenType.PARENTESIS_ABRE):
            self.match(TokenType.PARENTESIS_ABRE)
            self.lista_expresiones()
            self.match(TokenType.PARENTESIS_CIERRA, {TokenType.PUNTO_Y_COMA, TokenType.END, TokenType.ELSE})
        else:
            self.error(
                "asignacion ':=' o llamada '('",
                {TokenType.PUNTO_Y_COMA, TokenType.END, TokenType.ELSE, TokenType.THEN, TokenType.DO},
            )

    # <comando_condicional> ::= if <expresion> then <comando_compuesto> <else_opcional>
    def comando_condicional(self) -> None:
        self.match(TokenType.IF)
        self.expresion()
        self.match(TokenType.THEN, self.FIRST_COMANDO | {TokenType.BEGIN, TokenType.ELSE, TokenType.END})
        self.comando_compuesto()
        self.else_opcional()

    # <else_opcional> ::= else <comando_compuesto> | λ
    def else_opcional(self) -> None:
        if self.check(TokenType.ELSE):
            self.match(TokenType.ELSE)
            self.comando_compuesto()

    # <comando_repetitivo> ::= while <expresion> do <comando>
    def comando_repetitivo(self) -> None:
        self.match(TokenType.WHILE)
        self.expresion()
        self.match(TokenType.DO, self.FIRST_COMANDO | {TokenType.BEGIN, TokenType.END, TokenType.ELSE})
        self.comando()

    # <comando_entrada_salida> ::= read ( identificador ) | write ( identificador )
    def comando_entrada_salida(self) -> None:
        if self.check(TokenType.READ):
            self.match(TokenType.READ)
            self.match(TokenType.PARENTESIS_ABRE)
            self.match(TokenType.IDENTIFICADOR)
            self.match(TokenType.PARENTESIS_CIERRA, {TokenType.PUNTO_Y_COMA, TokenType.END, TokenType.ELSE})
        elif self.check(TokenType.WRITE):
            self.match(TokenType.WRITE)
            self.match(TokenType.PARENTESIS_ABRE)
            self.match(TokenType.IDENTIFICADOR)
            self.match(TokenType.PARENTESIS_CIERRA, {TokenType.PUNTO_Y_COMA, TokenType.END, TokenType.ELSE})
        else:
            self.error("read o write", {TokenType.PUNTO_Y_COMA, TokenType.END, TokenType.ELSE})

    # <expresion> ::= <expresion_simple> <expresion_aux>
    def expresion(self) -> None:
        self.expresion_simple()
        self.expresion_aux()

    # <expresion_aux> ::= <relacion> <expresion_simple> | λ
    def expresion_aux(self) -> None:
        if self.preanalisis.tipo in self.RELACIONES:
            self.relacion()
            self.expresion_simple()

    # <lista_expresiones> ::= <expresion> <lista_expresiones_aux>
    def lista_expresiones(self) -> None:
        self.expresion()
        self.lista_expresiones_aux()

    # <lista_expresiones_aux> ::= , <expresion> <lista_expresiones_aux> | λ
    def lista_expresiones_aux(self) -> None:
        if self.check(TokenType.COMA):
            self.match(TokenType.COMA)
            self.expresion()
            self.lista_expresiones_aux()

    # <expresion_simple> ::= <signo_opcional> <termino> <expresion_simple_aux>
    def expresion_simple(self) -> None:
        self.signo_opcional()
        self.termino()
        self.expresion_simple_aux()

    # <signo_opcional> ::= + | - | λ
    def signo_opcional(self) -> None:
        if self.check(TokenType.MAS):
            self.match(TokenType.MAS)
        elif self.check(TokenType.MENOS):
            self.match(TokenType.MENOS)

    # <expresion_simple_aux> ::= <operador_aditivo> <termino> <expresion_simple_aux> | λ
    def expresion_simple_aux(self) -> None:
        if self.preanalisis.tipo in self.OPERADORES_ADITIVOS:
            self.operador_aditivo()
            self.termino()
            self.expresion_simple_aux()

    # <termino> ::= <factor> <termino_aux>
    def termino(self) -> None:
        self.factor()
        self.termino_aux()

    # <termino_aux> ::= <operador_multiplicativo> <factor> <termino_aux> | λ
    def termino_aux(self) -> None:
        if self.preanalisis.tipo in self.OPERADORES_MULTIPLICATIVOS:
            self.operador_multiplicativo()
            self.factor()
            self.termino_aux()

    # <factor> ::= identificador <resto_factor>
    #            | numero
    #            | ( <expresion> )
    #            | not <factor>
    def factor(self) -> None:
        if self.check(TokenType.IDENTIFICADOR):
            self.match(TokenType.IDENTIFICADOR)
            self.resto_factor()
        elif self.check(TokenType.NUMERO):
            self.match(TokenType.NUMERO)
        elif self.check(TokenType.PARENTESIS_ABRE):
            self.match(TokenType.PARENTESIS_ABRE)
            self.expresion()
            self.match(TokenType.PARENTESIS_CIERRA)
        elif self.check(TokenType.NOT):
            self.match(TokenType.NOT)
            self.factor()
        else:
            self.error("factor", self.TOKENS_FIN_EXPRESION)

    # <resto_factor> ::= ( <lista_expresiones> ) | λ
    def resto_factor(self) -> None:
        if self.check(TokenType.PARENTESIS_ABRE):
            self.match(TokenType.PARENTESIS_ABRE)
            self.lista_expresiones()
            self.match(TokenType.PARENTESIS_CIERRA, self.TOKENS_FIN_EXPRESION)

    # <relacion> ::= = | <> | < | <= | >= | >
    def relacion(self) -> None:
        if self.preanalisis.tipo in self.RELACIONES:
            self.advance()
        else:
            self.error("operador relacional", self.TOKENS_FIN_EXPRESION)

    # <operador_aditivo> ::= + | - | or
    def operador_aditivo(self) -> None:
        if self.preanalisis.tipo in self.OPERADORES_ADITIVOS:
            self.advance()
        else:
            self.error("operador aditivo", self.TOKENS_FIN_EXPRESION)

    # <operador_multiplicativo> ::= * | div | and
    def operador_multiplicativo(self) -> None:
        if self.preanalisis.tipo in self.OPERADORES_MULTIPLICATIVOS:
            self.advance()
        else:
            self.error("operador multiplicativo", self.TOKENS_FIN_EXPRESION)

    def match(self, expected: TokenType, sincronizacion: set[TokenType] | None = None) -> Token:
        if self.check(expected):
            return self.advance()

        esperado = TOKEN_NAMES[expected]
        encontrado = self.describe_token(self.preanalisis)
        self.registrar_error(f"se esperaba {esperado}, se encontro {encontrado}")

        if self.check_next(expected):
            self.advance()
            return self.advance()

        if self.preanalisis.tipo == TokenType.EOF:
            return Token(expected, "", self.preanalisis.linea, self.preanalisis.columna)

        tokens_sincronizacion = self.TOKENS_RECUPERACION | (sincronizacion or set())
        if self.preanalisis.tipo in tokens_sincronizacion:
            return Token(expected, "", self.preanalisis.linea, self.preanalisis.columna)

        token = self.preanalisis
        self.advance()
        return Token(expected, "", token.linea, token.columna)

    def check(self, tipo: TokenType) -> bool:
        return self.preanalisis.tipo == tipo

    def check_next(self, tipo: TokenType) -> bool:
        if self.current + 1 >= len(self.tokens):
            return False
        return self.tokens[self.current + 1].tipo == tipo

    def advance(self) -> Token:
        token = self.preanalisis
        if not self.check(TokenType.EOF):
            self.current += 1
        return token

    def error(self, esperado: str, sincronizacion: set[TokenType] | None = None) -> None:
        encontrado = self.describe_token(self.preanalisis)
        self.registrar_error(f"se esperaba {esperado}, se encontro {encontrado}")

        if self.preanalisis.tipo == TokenType.EOF:
            return

        tokens_sincronizacion = self.TOKENS_RECUPERACION | (sincronizacion or set())
        if self.preanalisis.tipo not in tokens_sincronizacion:
            self.advance()

    def registrar_error(self, detalle: str) -> None:
        diagnostic = DiagnosticoError(
            "sintactico",
            self.preanalisis.linea,
            self.preanalisis.columna,
            detalle,
        )

        if not self.diagnostics or self.diagnostics[-1] != diagnostic:
            self.diagnostics.append(diagnostic)

    @staticmethod
    def describe_token(token: Token) -> str:
        nombre = TOKEN_NAMES[token.tipo]
        if token.lexema:
            return f"{nombre} ({token.lexema!r})"
        return nombre


def crear_diagnostico(exc: SyntaxErrorParser) -> DiagnosticoError:
    return DiagnosticoError("sintactico", exc.linea, exc.columna, exc.detalle)



def construir_ruta_salida() -> Path:
    return Path(__file__).resolve().with_name("salidaSintactico.txt")



def calcular_columna_visual(linea: str, columna: int) -> int:
    prefijo = linea[: max(columna - 1, 0)]
    return len(prefijo.expandtabs(4))



def formatear_fuente(source: str, diagnostics: list[DiagnosticoError]) -> list[str]:
    lineas = source.splitlines()
    if source.endswith("\n"):
        lineas.append("")
    if not lineas:
        lineas = [""]

    max_linea = max((diagnostic.linea for diagnostic in diagnostics), default=1)
    while len(lineas) < max_linea:
        lineas.append("")

    diagnostics_por_linea: dict[int, list[DiagnosticoError]] = {}
    for diagnostic in diagnostics:
        diagnostics_por_linea.setdefault(diagnostic.linea, []).append(diagnostic)

    ancho = len(str(len(lineas)))
    salida: list[str] = []

    for numero_linea, contenido in enumerate(lineas, start=1):
        contenido_expandido = contenido.expandtabs(4)
        salida.append(f"{numero_linea:>{ancho}} | {contenido_expandido}")

        for diagnostic in sorted(
            diagnostics_por_linea.get(numero_linea, []),
            key=lambda item: item.columna,
        ):
            columna_visual = calcular_columna_visual(contenido, diagnostic.columna)
            indicador = " " * columna_visual + "^"
            detalle = " " * columna_visual + diagnostic.mensaje
            salida.append(f"{' ' * ancho} | {indicador}")
            salida.append(f"{' ' * ancho} | {detalle}")

    return salida


def generar_reporte(resultado: ResultadoAnalisis) -> str:
    reporte = [
        f"Archivo analizado: {resultado.path.name}",
        f"Ruta original: {resultado.path}",
        f"Resultado: {resultado.mensaje}",
        "",
        "Diagnosticos:",
    ]

    if resultado.diagnostics:
        reporte.extend(f"- {diagnostic.mensaje}" for diagnostic in resultado.diagnostics)
    else:
        reporte.append("- No se detectaron errores.")

    reporte.extend(["", "Codigo fuente:"])
    reporte.extend(formatear_fuente(resultado.source, resultado.diagnostics))
    reporte.append("")
    return "\n".join(reporte)



def construir_mensaje_sintactico(diagnostics: list[DiagnosticoError]) -> str:
    if len(diagnostics) == 1:
        return diagnostics[0].mensaje
    return f"Se detectaron {len(diagnostics)} errores sintacticos"



def escribir_reporte(resultado: ResultadoAnalisis) -> Path:
    ruta_salida = construir_ruta_salida()
    ruta_salida.write_text(generar_reporte(resultado), encoding="utf-8")
    return ruta_salida



def analizar_archivo(path: Path) -> ResultadoAnalisis:
    if not path.exists():
        raise FileNotFoundError(f"No existe el archivo: {path}")

    source = path.read_text(encoding="utf-8")

    try:
        tokens = obtener_tokens_desde_analizador_lexico(source)
    except SyntaxErrorParser as exc:
        diagnostic = crear_diagnostico(exc)
        return ResultadoAnalisis(path, source, False, diagnostic.mensaje, [diagnostic])

    parser = Parser(tokens)
    diagnostics = parser.parse()

    if diagnostics:
        return ResultadoAnalisis(
            path,
            source,
            False,
            construir_mensaje_sintactico(diagnostics),
            diagnostics,
        )

    return ResultadoAnalisis(path, source, True, "Analisis sintactico correcto", [])



def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print("Uso: analizadorSintactico archivodeprueba.pas")
        return 2

    path = Path(argv[1])

    try:
        resultado = analizar_archivo(path)
        escribir_reporte(resultado)
        print(resultado.mensaje)
        return 0 if resultado.ok else 1

    except FileNotFoundError as exc:
        print(f"Error: {exc}")
        return 1

    except EntradaNoValidaParaSintactico as exc:
        print(f"Error: {exc}")
        return 1

    except OSError as exc:
        print(f"Error al escribir el archivo de salida: {exc}")
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
