#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Analizador Sintáctico Descendente Recursivo Predictivo para mini-Pascal.

Uso:
    python3 analizadorSintactico archivodeprueba.pas

También puede ejecutarse como:
    ./analizadorSintactico archivodeprueba.pas

El analizador implementa la gramática BNF LL(1) diseñada en el Laboratorio 4.
Asume que la entrada ya fue validada por `analizadorLexico`.
Si el archivo pertenece al lenguaje, informa "Analisis sintactico correcto".
Si hay error sintáctico, informa línea, columna, token encontrado y
token/producción esperada.
Además genera un único archivo `salidaSintactico.txt` con el código fuente
numerado y los errores sintácticos marcados.
"""

from __future__ import annotations

import runpy
import sys
from dataclasses import dataclass
from enum import Enum, auto
from functools import lru_cache
from pathlib import Path


class TokenType(Enum):
    # Palabras reservadas
    PROGRAM = auto()
    VAR = auto()
    INTEGER = auto()
    BOOLEAN = auto()
    TRUE = auto()
    FALSE = auto()
    PROCEDURE = auto()
    FUNCTION = auto()
    BEGIN = auto()
    END = auto()
    IF = auto()
    THEN = auto()
    ELSE = auto()
    WHILE = auto()
    DO = auto()
    READ = auto()
    WRITE = auto()
    OR = auto()
    DIV = auto()
    AND = auto()
    NOT = auto()

    # Clases léxicas
    IDENTIFICADOR = auto()
    NUMERO = auto()

    # Símbolos simples
    PUNTO_Y_COMA = auto()   # ;
    DOS_PUNTOS = auto()     # :
    COMA = auto()           # ,
    PUNTO = auto()          # .
    PARENTESIS_ABRE = auto()
    PARENTESIS_CIERRA = auto()
    MAS = auto()
    MENOS = auto()
    POR = auto()

    # Símbolos compuestos / relacionales
    ASIGNACION = auto()     # :=
    IGUAL = auto()
    DISTINTO = auto()       # <>
    MENOR = auto()
    MENOR_IGUAL = auto()
    MAYOR = auto()
    MAYOR_IGUAL = auto()

    EOF = auto()


